# Copy this file to `.env` and fill it in. docker-compose reads `.env`
# automatically. The SAME file shape works locally and on a VPS — only
# PUBLIC_HOST (and the secrets) change.

# ====================================================================
# ARENA test environment (docker compose up --build)
# ====================================================================

# Where players reach this deployment. Locally: localhost. On a VPS:
# its public IP (e.g. 203.0.113.10). This value is baked into the client
# bundle AND used as the SIWS domain, so it must be exactly what the
# browser shows in its address bar.
PUBLIC_HOST=localhost

# Host ports (container ports are fixed: server 2567, client 80).
SERVER_PORT=2567
CLIENT_PORT=8080

# The on-chain round the server escrows against. Open one with:
#   yarn ts-mocha -p ./tsconfig.json -t 1000000 scripts/init-arena-devnet.ts
# A devnet round lives ~24h — refresh this when the server logs "Ended".
ROUND_ID=

# Solana RPC. Public devnet is fine for a few friends; a dedicated
# devnet endpoint (Helius/QuickNode) is far steadier under load.
RPC_URL=https://api.devnet.solana.com

# REQUIRED in Docker: server and settlement are separate containers, so
# their traffic is not loopback — this shared secret is what authorizes
# the settlement service against /settlement/*. Use a long random string:
#   openssl rand -hex 32
SETTLEMENT_SECRET=

# Host path to the AUTHORITY keypair (the wallet that signs payouts and
# holds the devnet SOL). Mounted read-only into the settlement container.
# This is the same key scripts/init-arena-devnet.ts used as authority.
AUTHORITY_KEYPAIR_HOST=./secrets/authority.json

# Optional: seconds between settlement polls; server-side tutorial bots.
POLL_INTERVAL_S=5
DEMO_BOTS=

# ====================================================================
# PostgreSQL — only the "full" profile (indexer/history). Not needed to
# just play. `docker compose --profile full up` to include it.
# ====================================================================
POSTGRES_USER=lottery
POSTGRES_PASSWORD=lottery
POSTGRES_DB=lottery_db
POSTGRES_PORT=5433

# Connection string used by the backend / sqlx tests
DATABASE_URL=postgres://lottery:lottery@localhost:5433/lottery_db
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=DD5CPAQWUtKSBajtNT9w4QbJysQnuWeDZ6yCdXKAYwro
