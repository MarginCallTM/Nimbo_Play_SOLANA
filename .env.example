# Copy this file to `.env` and fill it in. docker-compose reads `.env`
# automatically. The SAME file shape works locally and on a VPS — only
# PUBLIC_HOST (and the secrets) change.

# ====================================================================
# ARENA test environment (docker compose up --build)
# ====================================================================

# --- Where the browser reaches things (baked into the client at build) --
# THREE deployment shapes — set VITE_SERVER_URL + AUTH_DOMAIN to match:
#   local http : VITE_SERVER_URL=http://localhost:2567   AUTH_DOMAIN=localhost:8080
#   VPS http   : VITE_SERVER_URL=http://<IP>:2567         AUTH_DOMAIN=<IP>:8080
#                (works BUT Phantom refuses to sign on a bare-IP http site
#                 — non-secure context. Use the HTTPS shape below.)
#   VPS HTTPS  : VITE_SERVER_URL=https://<host>.sslip.io  AUTH_DOMAIN=<host>.sslip.io
#                SITE_HOST=<host>.sslip.io
#                run: docker compose --profile https up -d --build
#
# The game server URL the client fetches from AND opens its WebSocket to.
VITE_SERVER_URL=http://localhost:2567
# The SIWS domain = window.location.host of the served page. MUST match
# where the client is actually opened, or Phantom rejects "wrong domain".
AUTH_DOMAIN=localhost:8080
# HTTPS only: the APEX hostname Caddy serves. AF.2 — Caddy now serves TWO
# hosts from this single value: SITE_HOST itself (the Nimbo Play portal)
# and arena.SITE_HOST (the game). Set the apex only.
#   real domain : SITE_HOST=nimboplay.dev
#                 -> VITE_SERVER_URL=https://arena.nimboplay.dev
#                 -> AUTH_DOMAIN=arena.nimboplay.dev
#   sslip.io    : SITE_HOST=167.233.250.97.sslip.io  (legacy, no purchase)
SITE_HOST=

# ====================================================================
# AF.2 — the Nimbo Play portal (Next.js, service `web`)
# ====================================================================
# ⚠ TWO things to know about every NEXT_PUBLIC_* below.
#
# 1. They are BAKED AT BUILD TIME. Next inlines them into the browser
#    bundle, exactly like VITE_SERVER_URL for the game client, so a change
#    needs `up -d --build web` — a restart does nothing.
#
# 2. They are PUBLIC BY CONSTRUCTION. The prefix means "shipped to every
#    visitor's browser": anyone can read them in devtools. A program id,
#    an RPC endpoint and a round id are public on-chain facts, so that is
#    fine — but it is also why a SECRET must never take this prefix.
#    The real secrets of this project live below and in the VPS .env only:
#    the authority keypair (signs payouts), SETTLEMENT_SECRET (authorizes
#    the debt ledger), and any paid RPC key inside RPC_URL. None of them
#    ever belongs in this example file.
NEXT_PUBLIC_PROGRAM_ID=DD5CPAQWUtKSBajtNT9w4QbJysQnuWeDZ6yCdXKAYwro
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com
# The lottery round the UI reads. Left EMPTY on purpose: a hardcoded id
# here would be stale within weeks and copied anyway. Example shape:
#   NEXT_PUBLIC_ROUND_ID=1782381011
NEXT_PUBLIC_ROUND_ID=
# Where the portal's "Play Arena" links point. Must match the arena host.
NEXT_PUBLIC_ARENA_URL=https://arena.nimboplay.dev
# Host port for the portal (container port is fixed at 3000).
WEB_PORT=3000

# Host ports (container ports are fixed: server 2567, client 80).
SERVER_PORT=2567
CLIENT_PORT=8080

# The on-chain round the server escrows against. Open one with:
#   yarn ts-mocha -p ./tsconfig.json -t 1000000 scripts/init-arena-devnet.ts
# A devnet round lives ~24h — refresh this when the server logs "Ended".
ROUND_ID=

# Solana RPC. Public devnet is fine for a few friends; a dedicated
# devnet endpoint (Helius/QuickNode) is far steadier under load.
RPC_URL=https://devnet.helius-rpc.com

# REQUIRED in Docker: server and settlement are separate containers, so
# their traffic is not loopback — this shared secret is what authorizes
# the settlement service against /settlement/*. Use a long random string:
#   openssl rand -hex 32
SETTLEMENT_SECRET=

# Host path to the AUTHORITY keypair (the wallet that signs payouts and
# holds the devnet SOL). Mounted read-only into the settlement container.
# This is the same key scripts/init-arena-devnet.ts used as authority.
AUTHORITY_KEYPAIR_HOST=./secrets/authority.json

# Optional: seconds between settlement polls; server-side tutorial bots.
POLL_INTERVAL_S=5
DEMO_BOTS=

# ====================================================================
# PostgreSQL — only the "full" profile (indexer/history). Not needed to
# just play. `docker compose --profile full up` to include it.
# ====================================================================
POSTGRES_USER=lottery
POSTGRES_PASSWORD=lottery
POSTGRES_DB=lottery_db
POSTGRES_PORT=5433

# Connection string used by the backend / sqlx tests
DATABASE_URL=postgres://lottery:lottery@localhost:5433/lottery_db
SOLANA_RPC_URL=https://devnet.helius-rpc.com
PROGRAM_ID=DD5CPAQWUtKSBajtNT9w4QbJysQnuWeDZ6yCdXKAYwro
